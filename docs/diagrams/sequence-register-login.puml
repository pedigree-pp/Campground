@startuml
header Campground Booking Sequence Diagram
title "Register and Log in"

participant "client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<controllers>>\n:auth" as controllersAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as UsersDatabase

== Register ==
client->server ++:req.post('/api/v1/auth/register')\n{name, telephone, email, password, role}
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth->controllersAuth ++:register()
controllersAuth->modelUser ++:create({name, telephone, email, password, role})
modelUser->modelUser :pre('save'): bcrypt hash password
modelUser->UsersDatabase ++:UserSchema
UsersDatabase-->modelUser --:user, or error
modelUser-->controllersAuth --:user, or error
alt valid fields and a new email
    controllersAuth->modelUser ++:getSignedJwtToken()
    modelUser-->controllersAuth --:token
    controllersAuth-->client :201 {success, token}\n+ token cookie
else missing or invalid field, or email already registered
    controllersAuth-->client :400 {success: false, msg}
end
deactivate controllersAuth
deactivate routerAuth
deactivate server

== Log in ==
client->server ++:req.post('/api/v1/auth/login')\n{email, password}
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth->controllersAuth ++:login()
break missing email or password
    controllersAuth-->client :400 {success: false,\nmsg: 'Please provide an email and password'}
end
controllersAuth->modelUser ++:findOne({email}).select('+password')
modelUser->UsersDatabase ++:UserSchema
UsersDatabase-->modelUser --:user, or null
modelUser-->controllersAuth --:user, or null
break no user with that email
    controllersAuth-->client :400 {success: false,\nmsg: 'Invalid credentials'}
end
controllersAuth->modelUser ++:matchPassword(password)
modelUser-->controllersAuth --:isMatch
break wrong password
    controllersAuth-->client :400 {success: false,\nmsg: 'Invalid credentials'}
end
controllersAuth->modelUser ++:getSignedJwtToken()
modelUser-->controllersAuth --:token
controllersAuth-->client --:200 {success, token}\n+ token cookie
deactivate routerAuth
deactivate server

== Log out ==
client->server ++:req.get('/api/v1/auth/logout')
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth->controllersAuth ++:logout()
controllersAuth-->client --:200 {success, data: {}}\n+ token cookie set to 'none' (expires in 10 s)
deactivate routerAuth
deactivate server
@enduml
