PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

JWT_SECRET=<any-long-random-string>
JWT_EXPIRE=30d

JWT_COOKIE_EXPIRE=30

RATE_LIMIT_MAX=1000

# How long an Offer is held; fractions work (0.25 is 15 seconds, for Newman and the demo)
OFFER_HOLD_MINUTES=1440

# Upstash QStash times Offer expiry. Left empty, the sweep expires Offers by itself, as on a local server
QSTASH_TOKEN=
# Take this from the same region as the token; left empty, it is https://qstash.upstash.io
QSTASH_URL=
# Left empty, every expire callback gets 401, so a copied placeholder can't be used to forge one
QSTASH_CURRENT_SIGNING_KEY=
# Where QStash can reach this server (a tunnel or a deployment), with no trailing slash
PUBLIC_URL=

# Ethereal test inbox: create an account at https://ethereal.email and copy its user and password here
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=<ethereal-user>
SMTP_PASSWORD=<ethereal-password>
FROM_NAME=Campground
FROM_EMAIL=noreply@campground.test
