PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

JWT_SECRET=<any-long-random-string>
JWT_EXPIRE=30d

JWT_COOKIE_EXPIRE=30

RATE_LIMIT_MAX=1000

OFFER_HOLD_MINUTES=1440

# Ethereal test inbox: create an account at https://ethereal.email and copy its user and password here
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=<ethereal-user>
SMTP_PASSWORD=<ethereal-password>
FROM_NAME=Campground
FROM_EMAIL=noreply@campground.test
