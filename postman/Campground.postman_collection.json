        {
          "name": "Login user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"123456\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('success is true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('returns a token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.test('sets the token cookie', () => pm.expect(pm.cookies.has('token')).to.be.true);",
                  "pm.collectionVariables.set('userToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('success is true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const user = pm.response.json().data;",
                  "pm.test('returns the logged-in user', () => pm.expect(user.email).to.eql(pm.collectionVariables.get('userEmail')));",
                  "pm.test('includes the telephone number', () => pm.expect(user.telephone).to.eql('0812345678'));",
                  "pm.test('never returns the password', () => pm.expect(user).to.not.have.property('password'));"
                ]
              }
            }
          ]
        },
